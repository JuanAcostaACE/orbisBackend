# Copiar a .env.postgres (ignorado por git) y sustituir los placeholders.
# Nunca subir el archivo real. Generar la contrasena con:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"

POSTGRES_DB=orbis_test
POSTGRES_USER=orbis_test
POSTGRES_PASSWORD=CAMBIAR_POR_CONTRASENA_LOCAL

# Usadas por el backend (Spring) contra el contenedor local:
DB_URL=jdbc:postgresql://localhost:5432/orbis_test
DB_USERNAME=orbis_test
DB_PASSWORD=CAMBIAR_POR_CONTRASENA_LOCAL
DB_DRIVER=org.postgresql.Driver
