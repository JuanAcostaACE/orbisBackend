// secrets.h.example
//
// Copiar este archivo a "secrets.h" (en esta misma carpeta) y reemplazar el valor.
// secrets.h NO se versiona: esta carpeta tiene un .gitignore que lo excluye.
// Ver docs/operacion-seguridad.md (rotacion del token).
//
// El valor debe ser IGUAL a APP_DEVICE_TOKEN configurado en Railway.
// Generar un valor nuevo solo en tu maquina, por ejemplo:
//   python -c "import secrets; print(secrets.token_urlsafe(32))"
// y pegarlo abajo. Nunca escribir el valor real en este archivo de ejemplo.

#pragma once

#define SECRET_DEVICE_TOKEN "REPLACE_WITH_LOCAL_TOKEN"
